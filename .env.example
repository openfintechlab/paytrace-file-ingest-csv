OFTL_SCA_CONTEXT_ROOT="/sca"
OFTL_SCA_VERSION="1"
OFTL_SCA_HOST="0.0.0.0"
OFTL_SCA_PORT="8081"

OFTL_LOG_LEVEL="INFO"
OFTL_LOG_FORMAT="[%(asctime)s] %(levelname)s [%(name)s.%(funcName)s:%(lineno)d] %(message)s"

OFTL_POSTGRESDB_USERNAME="admin"
OFTL_POSTGRESDB_PASSWORD="[CHANGE ME]"
OFTL_POSTGRESDB_HOST="localhost"
OFTL_POSTGRESDB_PORT=5432
OFTL_POSTGRESDB_NAME="public"
OFTL_POSTGRESDB_SCHEMA="public"
OFTL_POSTGRESDB_POOLSIZE=10

OFTL_FWCSV_ROOTDIR="./fwcsv"
OFTL_FWCSV_SCAN_INTERVAL_SECONDS=10
OFTL_FWCSV_STABILITY_WINDOW_SECONDS=5
OFTL_FWCSV_STABILITY_PROBE_SECONDS=1
OFTL_FWCSV_CLAIM_RETRY_SECONDS=2
OFTL_FWCSV_CLAIM_MAX_WAIT_SECONDS=60
OFTL_FWCSV_WORKER_COUNT=2
OFTL_FWCSV_QUEUE_MAXSIZE=1000
OFTL_FWCSV_CHECKPOINT_EVERY_ROWS=1000
OFTL_FWCSV_FILE_ENCODING="utf-8"

OFTL_RABITMQ_HOST="localhost"
OFTL_RABITMQ_PORT=5672
OFTL_RABITMQ_USERNAME="guest"
OFTL_RABITMQ_PASSWORD_SECRET="[CHANGE ME]"
OFTL_RABITMQ_VHOST="/"
OFTL_RABITMQ_HEARTBEAT=60
OFTL_RABITMQ_BLOCKED_CONNECTION_TIMEOUT=30
OFTL_RABITMQ_CONNECTION_ATTEMPTS=3
OFTL_RABITMQ_CONN_RETRYCOUNT=3
OFTL_RABITMQ_RETRY_DELAY=2
OFTL_RABITMQ_SOCKET_TIMEOUT=5
OFTL_RABITMQ_STACK_TIMEOUT=10
OFTL_RABITMQ_QUEUE_DURABLE="true"
OFTL_RABITMQ_EXCHANGE_DURABLE="true"
OFTL_RABITMQ_EXCHANGE_TYPE="direct"
OFTL_RABITMQ_PUBEVENT_EXCHANGE="paytrace.events"
OFTL_RABITMQ_PUBEVENT_EV001="files.csv.loaded"
OFTL_RABITMQ_PUBEVENT_EV002="files.csv.row.failed"
OFTL_RABITMQ_MESSAGE_PERSISTENT="true"
OFTL_RABITMQ_PUBLISH_MANDATORY="false"
OFTL_RABITMQ_DOEMSTIC_REQUEST_QUEUE="CSV.PAYMENTS.DOMESTIC.REQ"
OFTL_RABITMQ_CROSS_BORDER_REQUEST_QUEUE="CSV.PAYMENTS.CROSS_BORDER.REQ"

