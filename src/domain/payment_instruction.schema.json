{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paytrace Payment Instruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transfer_id",
    "transfer_type",
    "transaction_datetime",
    "requested_execution_date",
    "amount",
    "currency",
    "debtor_name",
    "debtor_country",
    "debtor_account_scheme",
    "debtor_account_id",
    "debtor_bank_id_scheme",
    "debtor_bank_id",
    "creditor_name",
    "creditor_country",
    "creditor_account_scheme",
    "creditor_account_id",
    "creditor_bank_id_scheme",
    "creditor_bank_id"
  ],
  "properties": {
    "transfer_id": {
      "type": "string",
      "maxLength": 36,
      "description": "Unique transaction identifier generated by sender"
    },
    "transfer_type": {
      "type": "string",
      "enum": ["DOMESTIC", "CROSS_BORDER"],
      "description": "Indicates if transfer is domestic or international"
    },
    "transaction_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time when payment instruction is created"
    },
    "requested_execution_date": {
      "type": "string",
      "format": "date",
      "description": "Date when payment should be executed"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.01,
      "description": "Payment amount"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "purpose_code": {
      "type": "string",
      "enum": ["SALA", "SUPP", "INVC", "TAXS", "RENT"],
      "description": "Purpose of payment"
    },
    "charge_bearer": {
      "type": "string",
      "enum": ["DEBT", "CRED", "SHAR"],
      "description": "Who bears transaction charges"
    },
    "exchange_rate": {
      "type": "number",
      "minimum": 0,
      "description": "FX rate if currency conversion required"
    },
    "debtor_name": {
      "type": "string",
      "maxLength": 140,
      "description": "Name of payer"
    },
    "debtor_country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 country code"
    },
    "debtor_account_scheme": {
      "type": "string",
      "enum": ["IBAN", "BBAN", "OTHER"]
    },
    "debtor_account_id": {
      "type": "string",
      "maxLength": 34,
      "description": "Account number / IBAN"
    },
    "debtor_bank_id_scheme": {
      "type": "string",
      "enum": ["BIC", "LOCAL"]
    },
    "debtor_bank_id": {
      "type": "string",
      "maxLength": 11,
      "description": "Debtor bank identifier (BIC)"
    },
    "creditor_name": {
      "type": "string",
      "maxLength": 140,
      "description": "Name of beneficiary"
    },
    "creditor_country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 country code"
    },
    "creditor_account_scheme": {
      "type": "string",
      "enum": ["IBAN", "BBAN", "OTHER"]
    },
    "creditor_account_id": {
      "type": "string",
      "maxLength": 34,
      "description": "Beneficiary account number"
    },
    "creditor_bank_id_scheme": {
      "type": "string",
      "enum": ["BIC", "LOCAL"]
    },
    "creditor_bank_id": {
      "type": "string",
      "maxLength": 11,
      "description": "Beneficiary bank identifier"
    },
    "intermediary_bank_bic": {
      "type": "string",
      "maxLength": 11,
      "description": "Intermediary bank BIC for cross-border payments"
    },
    "remittance_unstructured": {
      "type": "string",
      "maxLength": 140,
      "description": "Free text payment description"
    },
    "remittance_reference": {
      "type": "string",
      "maxLength": 35,
      "description": "Structured reference number"
    }
  }
}
